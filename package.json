{
  "name": "mficrm",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "prisma generate && nuxt prepare",
    "db:up": "docker compose -f docker/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "claude:login": "kamal app exec -i --reuse \"env HOME=/data/claude-home claude auth login --claudeai\"",
    "claude:status": "kamal app exec --reuse \"env HOME=/data/claude-home claude auth status --json\"",
    "claude:login:local": "claude auth login --claudeai"
  },
