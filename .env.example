DATABASE_URL=./db/crm.db
# Session cookie encryption key for nuxt-auth-utils, at least 32 characters (openssl rand -hex 32).
# In dev, nuxt-auth-utils writes one to .env automatically if it is missing.
NUXT_SESSION_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Base URL used in links inside reminder emails
APP_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=crm@example.com
UPLOAD_DIR=./uploads
