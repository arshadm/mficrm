DATABASE_URL=postgresql://mficrm:mficrm@localhost:5433/mficrm
# Session cookie encryption key for nuxt-auth-utils, at least 32 characters (openssl rand -hex 32).
# In dev, nuxt-auth-utils writes one to .env automatically if it is missing.
NUXT_SESSION_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Base URL used in links inside reminder emails
APP_URL=http://localhost:3000
# Leave SMTP_HOST empty to skip reminder emails. Production: smtp.gmail.com with a Google App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=crm@example.com
UPLOAD_DIR=./uploads
# AI assistance runs the Claude Code CLI (`claude`), signed in with a Claude subscription: in development, your
# own login (`claude auth login`). CLAUDE_MODEL defaults to claude-sonnet-5-5. CLAUDE_HOME moves the CLI's login
# (production: /data/claude-home); leave it unset locally.
CLAUDE_MODEL=
CLAUDE_HOME=
