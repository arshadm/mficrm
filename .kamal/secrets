# Secrets for config/deploy.yml, read from Bitwarden at deploy time. This file is safe for git:
# DO NOT put raw credentials here. Every name below must exist as a field on the Bitwarden item "mficrm-prod".
# Generate values with docs/deploy.md ("Secrets").

# Docker Hub access token for artemissoft1 (same as stepwise and the spinorml website)
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

SECRETS=$(kamal secrets fetch --adapter bitwarden --account arshadm@artemissoft.com --from mficrm-prod POSTGRES_PASSWORD NUXT_SESSION_PASSWORD ADMIN_PASSWORD SMTP_USER SMTP_PASS S3_ENDPOINT S3_ACCESS_KEY_ID S3_SECRET_ACCESS_KEY ORIGIN_CERTIFICATE_B64 ORIGIN_PRIVATE_KEY_B64)

# Cloudflare Origin CA certificate and key for kamal-proxy (Cloudflare SSL mode "Full (strict)").
# Bitwarden text fields lose line breaks, so bin/kamal-pem rebuilds the PEMs. Each field may hold either the PEM as
# pasted or the PEM base64-encoded (base64 < origin.pem | tr -d '\n'); a bad value stops with a clear message.
ORIGIN_CERTIFICATE_B64=$(kamal secrets extract ORIGIN_CERTIFICATE_B64 $SECRETS)
ORIGIN_PRIVATE_KEY_B64=$(kamal secrets extract ORIGIN_PRIVATE_KEY_B64 $SECRETS)
ORIGIN_CERTIFICATE_PEM=$(bin/kamal-pem ORIGIN_CERTIFICATE_B64 "$ORIGIN_CERTIFICATE_B64")
ORIGIN_PRIVATE_KEY_PEM=$(bin/kamal-pem ORIGIN_PRIVATE_KEY_B64 "$ORIGIN_PRIVATE_KEY_B64")

# Database: the "db" accessory. The password must be letters and digits only (openssl rand -hex 24), because it goes
# into DATABASE_URL as is. For a managed Postgres instead, store DATABASE_URL in Bitwarden and extract it here.
POSTGRES_PASSWORD=$(kamal secrets extract POSTGRES_PASSWORD $SECRETS)
DATABASE_URL=postgresql://mficrm:$POSTGRES_PASSWORD@mficrm-db:5432/mficrm

# Session cookie encryption key for nuxt-auth-utils (at least 32 characters). Changing it logs everyone out.
NUXT_SESSION_PASSWORD=$(kamal secrets extract NUXT_SESSION_PASSWORD $SECRETS)

# Password for the admin user, created on first boot only (server/db/seed.ts). Changing it later has no effect.
ADMIN_PASSWORD=$(kamal secrets extract ADMIN_PASSWORD $SECRETS)

# SMTP login for the follow-up reminder emails
SMTP_USER=$(kamal secrets extract SMTP_USER $SECRETS)
SMTP_PASS=$(kamal secrets extract SMTP_PASS $SECRETS)

# Backups (the "backups" and "uploads-backup" accessories): a Cloudflare R2 bucket "mficrm-backups" and an R2 API
# token with Object Read & Write on that bucket only. S3_ENDPOINT is https://<account id>.r2.cloudflarestorage.com
S3_ENDPOINT=$(kamal secrets extract S3_ENDPOINT $SECRETS)
S3_ACCESS_KEY_ID=$(kamal secrets extract S3_ACCESS_KEY_ID $SECRETS)
S3_SECRET_ACCESS_KEY=$(kamal secrets extract S3_SECRET_ACCESS_KEY $SECRETS)
# The same credentials under the names offen/docker-volume-backup reads (its endpoint is a host, without https://)
AWS_ENDPOINT=$(echo "$S3_ENDPOINT" | cut -d/ -f3)
AWS_ACCESS_KEY_ID=$S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$S3_SECRET_ACCESS_KEY
